# ===========================================
# GIFTMAKEBOT DEVELOPMENT ENVIRONMENT
# ===========================================
# Development environment configuration
# For local development and testing

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_ENV=development
DEBUG=true

# ===========================================
# CONTAINER NAMES
# ===========================================
NGINX_CONTAINER_NAME=giftmakebot_dev_nginx
REDIS_CONTAINER_NAME=giftmakebot_dev_redis
RABBITMQ_CONTAINER_NAME=giftmakebot_dev_rabbitmq
TELEGRAM_BOT_CONTAINER_NAME=giftmakebot_dev_telegram
HEALTH_CONTAINER_NAME=giftmakebot_dev_health
API_GATEWAY_CONTAINER_NAME=giftmakebot_dev_api_gateway
WEB_APP_CONTAINER_NAME=giftmakebot_dev_webapp

# ===========================================
# NETWORK SETTINGS
# ===========================================
NETWORK_NAME=giftmakebot_dev_network
NETWORK_DRIVER=bridge

# ===========================================
# PORT MAPPINGS (Development ports)
# ===========================================
HTTP_PORT=8080
HTTPS_PORT=8443
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
WEB_APP_PORT=3001

# ===========================================
# VOLUME SETTINGS
# ===========================================
MYSQL_VOLUME=mysql_dev_data
REDIS_VOLUME=redis_dev_data
RABBITMQ_DATA_VOLUME=rabbitmq_dev_data
RABBITMQ_LOGS_VOLUME=rabbitmq_dev_logs

# ===========================================
# RESTART POLICIES
# ===========================================
RESTART_POLICY=unless-stopped

# ===========================================
# REDIS CONFIGURATION (Development)
# ===========================================
REDIS_PASSWORD=DevRedis@2025
REDIS_IMAGE=redis:7-alpine
REDIS_COMMAND_OPTIONS=--appendonly yes

# ===========================================
# RABBITMQ CONFIGURATION (Development)
# ===========================================
RABBITMQ_IMAGE=rabbitmq:3-management-alpine
RABBITMQ_USER=dev_admin
RABBITMQ_PASSWORD=DevRabbitMQ@2025
RABBITMQ_VHOST=/dev
RABBITMQ_ERLANG_COOKIE=giftmakebot-dev-rabbitmq-cluster-secret-cookie

# ===========================================
# NGINX CONFIGURATION
# ===========================================
NGINX_IMAGE=nginx:alpine

# ===========================================
# TELEGRAM BOT CONFIGURATION (Development)
# ===========================================
# Test bot token for development
TELEGRAM_BOT_TOKEN=6433432668:AAF7eJ0RAmXRMIVXmq0KonCkfmwwoeLt5RU
TELEGRAM_SUPER_ADMIN_ID=686980246

# ===========================================
# DEVELOPMENT SPECIFIC SETTINGS
# ===========================================
# Hot reload and development features
HOT_RELOAD=true
WATCH_MODE=true
LOG_LEVEL=debug
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. These are development credentials - safe for local use
# 2. Never use development credentials in production
# 3. Hot reload and debug modes enabled for development
# 4. CORS is enabled for local development
# ===========================================
# GIFTMAKEBOT ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and update with your actual values
# Never commit .env file to version control!

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_ENV=production
DEBUG=false

# ===========================================
# CONTAINER NAMES
# ===========================================
NGINX_CONTAINER_NAME=giftmakebot_nginx
REDIS_CONTAINER_NAME=giftmakebot_redis
TELEGRAM_BOT_CONTAINER_NAME=giftmakebot_telegram
HEALTH_CONTAINER_NAME=giftmakebot_health

# ===========================================
# PORT MAPPINGS
# ===========================================
HTTP_PORT=80
HTTPS_PORT=443
REDIS_PORT=6379

# ===========================================
# RESTART POLICIES
# ===========================================
RESTART_POLICY=unless-stopped

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Set a strong password for Redis
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_IMAGE=redis:7-alpine
REDIS_COMMAND_OPTIONS=--appendonly yes

# ===========================================
# NGINX CONFIGURATION
# ===========================================
NGINX_IMAGE=nginx:alpine

# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================
# Get this token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SUPER_ADMIN_ID=your_admin_user_id_here

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Change all default passwords before deploying
# 2. Use strong, unique passwords for production
# 3. Never commit this file to version control
# 4. Add .env to your .gitignore file